{
  "name": "mocha-muse-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:start --only firestore,auth --project demo-mocha-muse",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mocha-muse \"vitest run tests/rules\""
  },
  "dependencies": {
    "@fontsource/amiri": "5.2.8",
    "@fontsource/aref-ruqaa": "5.2.8",
    "@fontsource/cormorant-garamond": "5.2.11",
    "@fontsource/jost": "5.2.8",
    "firebase": "13.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "firebase-tools": "15.37.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "react-router-dom": "7.18.7"
  }
}
