# Public, non-secret settings baked into the site at build time.
# Copy to .env.production (committed) or .env.local (not committed) and fill in.

# reCAPTCHA v3 site key for Firebase App Check (Firebase console > App Check > Apps > Register web app).
VITE_RECAPTCHA_SITE_KEY=

# Address (or FormSubmit alias) that receives new-order emails. Leave empty to turn emails off.
VITE_FORMSUBMIT_TO=

# Local development only: talk to the Firebase emulators instead of the live project.
VITE_USE_EMULATORS=false
